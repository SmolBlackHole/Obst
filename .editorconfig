[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,css,scss,sass,less,styl}]
charset = utf-8
indent_size = 4
indent_style = tab
tab_width = 4
insert_spaces = false
insert_final_newline = true
trim_trailing_whitespace = true

end_of_line = lf
max_line_length = 100

[*.{json,json5}]
indent_size = 4
indent_style = tab
tab_width = 4
insert_spaces = false
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
indent_size = 4
indent_style = tab
tab_width = 4
insert_spaces = false
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 4
indent_style = space
tab_width = 4
insert_spaces = true
insert_final_newline = true
trim_trailing_whitespace = true

[*.{html,htm}]
indent_size = 4
indent_style = space
tab_width = 4
insert_spaces = true
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4
indent_style = space
tab_width = 4
insert_spaces = true
insert_final_newline = true
trim_trailing_whitespace = true
